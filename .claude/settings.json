{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-remote.sh\"",
            "timeout": 30,
            "statusMessage": "Syncing with origin..."
          }
        ]
      }
    ]
  }
}
